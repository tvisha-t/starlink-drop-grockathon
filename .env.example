# Copy this file to .env and fill in real values. Never commit .env.
XAI_API_KEY=xai-...
XAI_MODEL=grok-4.7
# fast model for scenario parsing, agent steps and the briefing
XAI_FAST_MODEL=grok-4.20-0309-non-reasoning
VOICE_AGENT_ID=agent_...
# Public URL of your backend (from ngrok) so the voice agent can report site status
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app
# Shared secret the voice agent sends with each report
VOICE_WEBHOOK_SECRET=change-me

# --- Grok Bot agent partners (see bots/README.md) ---
# Key the Bots send as "Authorization: Bearer <key>" when they call this app
BOT_API_KEY=make-a-long-random-string
# Each Bot routine's webhook ("POST to" URL and its secret key)
GROKBOT_FORECAST_URL=
GROKBOT_FORECAST_KEY=
GROKBOT_SCOUT_URL=
GROKBOT_SCOUT_KEY=
GROKBOT_DISPATCH_URL=
GROKBOT_DISPATCH_KEY=
# 1 = a new forecast plan is sent to Scout Bot automatically to check
AUTO_SCOUT=1
